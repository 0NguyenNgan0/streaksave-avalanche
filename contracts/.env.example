# ==============================================================================
# StreakSave Smart Contracts — Deployment Environment Template
# ==============================================================================
# Copy this file to `contracts/.env` only when performing an authorized deployment.
# NEVER commit `.env` or any real private key / mnemonic to Git.
# Use a dedicated Avalanche Fuji testnet Dev Wallet with zero mainnet funds.
# ==============================================================================

# Required: Deployer private key WITH 0x prefix (Fuji testnet Dev Wallet only)
DEPLOYER_PRIVATE_KEY=

# Avalanche Fuji C-Chain RPC URL
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Epoch duration in seconds (MVP demo default: 60s; production concept: 604800s / 7 days)
EPOCH_DURATION=60

# Optional: Initial MockUSDC minted to deployer in 6-decimal base units (1000_000000 = 1,000 USDC)
INITIAL_DEMO_MINT=1000000000

# Optional: Reuse an existing MockUSDC address (leave empty to deploy a fresh MockUSDC)
MOCK_USDC_ADDRESS=

# Set to true ONLY when simulating/deploying against local Anvil (chainId 31337)
ALLOW_LOCAL_CHAIN=false

# Optional: Explorer verification key (Snowtrace / Routescan)
SNOWTRACE_API_KEY=verifyContract
